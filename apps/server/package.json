{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev:bare": "node ../web/node_modules/wrangler/bin/wrangler.js dev --local --config wrangler.local.jsonc",
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"env:generate": "varlock codegen"
	},
	"dependencies": {
		"drizzle-orm": "catalog:",
		"@hono/trpc-server": "^0.4.2",
		"@store-managment-communal-web/api": "workspace:*",
		"@store-managment-communal-web/auth": "workspace:*",
		"@store-managment-communal-web/db": "workspace:*",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"hono": "^4.13.7",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@hono/cli": "^1.0.0-rc.6",
		"@store-managment-communal-web/config": "workspace:*",
		"@store-managment-communal-web/infra": "workspace:*",
		"@types/bun": "^1.4.3",
		"@types/node": "catalog:",
		"miniflare": "5.20261012.0-beta",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	}
}
