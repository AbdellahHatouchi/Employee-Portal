{
	"name": "store-managment-communal-web",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/node": "^26.4.1",
			"varlock": "1.18.0",
			"@cloudflare/workers-types": "^5.20260906.1",
			"@trpc/server": "^11.19.0",
			"better-auth": "1.7.7",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"@trpc/client": "^11.19.0",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"tailwindcss": "^4.3.3",
			"drizzle-orm": "1.0.0-rc.4"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev:bare -F web --",
		"dev:server": "turbo run dev:bare -F server --",
		"test:portal": "bun scripts/portal-smoke.ts",
		"test:exchange": "bun test ./apps/server/src/sync/exchange.test.ts",
		"test:portal:isolated": "bun scripts/portal-isolated-smoke.ts",
		"db:generate": "turbo run db:generate -F @store-managment-communal-web/db --",
		"deploy": "turbo run deploy -F @store-managment-communal-web/infra --",
		"destroy": "turbo run destroy -F @store-managment-communal-web/infra --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/workers-types": "catalog:",
		"@store-managment-communal-web/config": "workspace:*",
		"@types/node": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.4"
}
